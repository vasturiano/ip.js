{
  "name": "ip.js",
  "version": "1.3.11",
  "description": "A JS library for manipulating IP addresses, prefixes and ranges. Supports both IPv4 and IPv6.",
  "unpkg": "dist/ip.min.js",
  "jsdelivr": "dist/ip.min.js",
  "main": "dist/ip.common.js",
  "module": "dist/ip.module.js",
  "types": "dist/ip.d.ts",
  "sideEffects": false,
  "keywords": [
    "ip",
    "prefix",
    "range",
    "ipv4",
    "ipv6",
    "internet",
    "protocol",
    "network",
    "bgp",
    "tcp/ip"
  ],
  "author": {
    "name": "Vasco Asturiano",
    "url": "https://github.com/vasturiano"
  },
  "license": "MIT",
  "homepage": "https://github.com/vasturiano/ip.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/vasturiano/ip.js.git"
  },
  "bugs": {
    "url": "https://github.com/vasturiano/ip.js/issues"
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "rimraf dist && rollup -c",
    "dev": "rollup -w -c rollup.config.dev.mjs",
    "test": "jest",
    "prepare": "npm run build"
  },
  "dependencies": {
    "jsbi": "^4.3.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/preset-env": "^8.0.7",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@typescript/typescript6": "^6.0.2",
    "jest": "^30.5.2",
    "rimraf": "^6.1.3",
    "rollup": "^4.64.6",
    "rollup-plugin-dts": "^6.5.1",
    "typescript": "^7.0.2"
  }
}
